# The template every fixture repo a charter-core test creates is made from (charter-app#191).
#
# A repository's own config beats the developer's global one, and it is read by EVERY git that
# touches the repository, the code under test included. So a developer whose ~/.gitconfig
# signs every commit does not have a signer asked, or a 1Password prompt raised, by a test.
[commit]
	gpgsign = false
[tag]
	gpgsign = false
# And a developer's global excludes file (core.excludesFile, or git's default
# ~/.config/git/ignore) does not decide what a fixture's git calls ignored (charter-app#262):
# one that lists .claude/settings.local.json made a test's own untracked file read as
# charter's to replace. /dev/null is an excludes file with nothing in it.
[core]
	excludesFile = /dev/null
