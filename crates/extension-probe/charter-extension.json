{
  "version": 2,
  "id": "extension-probe",
  "name": "Extension probe",
  "capabilities": [
    "probe",
    "badges",
    "repo-columns",
    "palette",
    "actions",
    "writes",
    "events",
    "briefing"
  ],
  "state": "state",
  "contributes": {
    "runs": "bin/extension-probe",
    "views": [
      {
        "id": "probe",
        "title": "Probe",
        "about": "personas"
      }
    ],
    "badges": [
      {
        "id": "asked",
        "label": "asked",
        "surfaces": ["status-bar", "footer"],
        "fresh_seconds": 3600
      }
    ],
    "repo-columns": [
      {
        "id": "asked",
        "title": "Asked",
        "fresh_seconds": 3600
      }
    ],
    "actions": [
      { "id": "jot", "title": "Jot a note", "confirm": false },
      { "id": "stray", "title": "Write outside", "confirm": false },
      { "id": "sweep", "title": "Sweep quietly", "confirm": false },
      { "id": "careful", "title": "Careful", "confirm": true },
      { "id": "forget", "title": "Forget the notes", "confirm": false, "deletes": true }
    ],
    "palette": [
      { "id": "open", "title": "Open the probe", "view": "probe" },
      { "id": "jot", "title": "Jot a note", "action": "jot" }
    ],
    "writes": ["notes/"],
    "events": {
      "hears": [
        "workspace-focused",
        "workspace-created",
        "workspace-forked",
        "workspace-removed",
        "handoff-created",
        "session-started",
        "plane-saved"
      ],
      "workspace_folder": "probe"
    },
    "briefing": {
      "title": "Probe"
    }
  }
}
