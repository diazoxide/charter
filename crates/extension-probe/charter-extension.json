{
  "version": 2,
  "id": "extension-probe",
  "name": "Extension probe",
  "capabilities": ["probe", "badges", "repo-columns", "events", "briefing"],
  "state": "state",
  "contributes": {
    "runs": "bin/extension-probe",
    "views": [
      {
        "id": "probe",
        "title": "Probe",
        "about": "personas"
      }
    ],
    "badges": [
      {
        "id": "asked",
        "label": "asked",
        "surfaces": ["status-bar", "footer"],
        "fresh_seconds": 3600
      }
    ],
    "repo-columns": [
      {
        "id": "asked",
        "title": "Asked",
        "fresh_seconds": 3600
      }
    ],
    "events": {
      "hears": [
        "workspace-focused",
        "workspace-created",
        "workspace-forked",
        "workspace-removed",
        "handoff-created",
        "session-started",
        "plane-saved"
      ],
      "workspace_folder": "probe"
    },
    "briefing": {
      "title": "Probe"
    }
  }
}
