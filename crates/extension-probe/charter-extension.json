{
  "version": 2,
  "id": "extension-probe",
  "name": "Extension probe",
  "capabilities": ["probe", "palette", "actions", "writes"],
  "contributes": {
    "runs": "bin/extension-probe",
    "views": [
      {
        "id": "probe",
        "title": "Probe",
        "about": "personas"
      }
    ],
    "actions": [
      { "id": "jot", "title": "Jot a note", "confirm": false },
      { "id": "stray", "title": "Write outside", "confirm": false },
      { "id": "sweep", "title": "Sweep quietly", "confirm": false },
      { "id": "careful", "title": "Careful", "confirm": true },
      { "id": "forget", "title": "Forget the notes", "confirm": false, "deletes": true }
    ],
    "palette": [
      { "id": "open", "title": "Open the probe", "view": "probe" },
      { "id": "jot", "title": "Jot a note", "action": "jot" }
    ],
    "writes": ["notes/"]
  }
}
