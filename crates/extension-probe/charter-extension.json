{
  "version": 3,
  "id": "extension-probe",
  "name": "Extension probe",
  "capabilities": ["probe", "badges", "repo-columns", "palette", "actions", "writes", "cli"],
  "state": "state",
  "contributes": {
    "runs": "bin/extension-probe",
    "views": [
      {
        "id": "probe",
        "title": "Probe",
        "about": "personas"
      }
    ],
    "badges": [
      {
        "id": "asked",
        "label": "asked",
        "surfaces": ["status-bar", "footer"],
        "fresh_seconds": 3600
      }
    ],
    "repo-columns": [
      {
        "id": "asked",
        "title": "Asked",
        "fresh_seconds": 3600
      }
    ],
    "actions": [
      { "id": "jot", "title": "Jot a note", "confirm": false },
      { "id": "stray", "title": "Write outside", "confirm": false },
      { "id": "sweep", "title": "Sweep quietly", "confirm": false },
      { "id": "careful", "title": "Careful", "confirm": true },
      { "id": "forget", "title": "Forget the notes", "confirm": false, "deletes": true }
    ],
    "palette": [
      { "id": "open", "title": "Open the probe", "view": "probe" },
      { "id": "jot", "title": "Jot a note", "action": "jot" }
    ],
    "writes": ["notes/"],
    "cli": [
      { "name": "echo", "title": "Say its words back", "writes": false },
      { "name": "fail", "title": "Exit with the status it is given", "writes": false },
      { "name": "scribble", "title": "Say it only reads, and write a note", "writes": false },
      { "name": "stamp", "title": "Stamp a note", "writes": true }
    ]
  }
}
