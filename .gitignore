mutants.out*/
.DS_Store

# Agent worktrees, created by the harness for isolated sub-agents.
.claude/worktrees/

# Python bytecode, which the CI tools under `tools/` can leave behind.
__pycache__/

# The charter binary the release workflow stages as a Tauri sidecar before bundling.
/app/src-tauri/binaries/

# Where the release workflow gathers the bundles it uploads.
/dist/
